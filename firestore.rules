rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Smart Network Monitoring System Collections
    // Allows monitoring agents and dashboard to read and write telemetry
    match /devices/{deviceId} {
      allow read, write: if true;
    }
    
    match /traffic/{trafficId} {
      allow read, write: if true;
    }
    
    match /alerts/{alertId} {
      allow read, write: if true;
    }
    
    match /networkStats/{statId} {
      allow read, write: if true;
    }
  }
}
